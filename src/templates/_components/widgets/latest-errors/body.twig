<div class="vredirect-widget-table-wrapper">
    &nbsp;
    <div id="{{ id }}"></div>
</div>

{% js %}
var columns = [
    {
        name: '__slot:title', title: Craft.t('vredirect', 'URI')
    },
    {
        name: 'hitCount', title: Craft.t('vredirect', 'Hit Count')
    },
    {
        name: 'dateCreated', title: Craft.t('vredirect', 'First Hit')
    }
];

{% if craft.app.user.checkPermission('vredirect:redirects:manage') %}
columns.push({
        name: 'menu', callback: function (value) {
            if (value) {
                return '<button class="btn primary small createRedirectBtn" data-id="'+value.id+'" data-site-id="'+value.siteId+'">' + Craft.t('vredirect', 'Redirect') + '</button>';
            }

            return '';
        }
    });
{% endif %}


var latestErrorsTable = new Craft.VueAdminTable().init({
    deleteAction: Craft.getActionUrl('vredirect/catch-all/delete-one'),
    columns: columns,
    container: '#{{ id }}',
    emptyMessage: Craft.t('vredirect', 'No 404s Registered'),
    padded: false,
    search: false,
    searchPlaceholder: Craft.t('vredirect', 'Search for 404s'),
    tableDataEndpoint: Craft.getActionUrl('vredirect/catch-all/hits-table?siteId={{ siteId|json_encode|raw }}&sort=dateUpdated%7Cdesc&per_page={{ count|json_encode|raw }}')
});

new Craft.Redirects.CatchAllIndex(latestErrorsTable, {
    container: '#{{ id }}',
    siteId: {{ siteId|json_encode|raw }}
});
{% endjs %}
